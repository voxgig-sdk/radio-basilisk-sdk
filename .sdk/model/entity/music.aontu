# Entity: music

main: kit: entity: music: {

  alias: field: {}

  fields: {
    album: {
      h: "Album"
      n: "album"
      r: false
      sh: "Album name"
      t: "`$STRING`"
    }
    artist: {
      h: "Artist"
      n: "artist"
      r: true
      sh: "Artist name"
      t: "`$STRING`"
    }
    coverImage: {
      fo: "uri"
      h: "Cover Image"
      n: "coverImage"
      r: false
      sh: "URL to the album cover image"
      t: "`$STRING`"
    }
    duration: {
      h: "Duration"
      n: "duration"
      r: false
      sh: "Duration of the song in seconds"
      t: "`$INTEGER`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Unique identifier for the song"
      t: "`$STRING`"
    }
    playedAt: {
      fo: "date-time"
      h: "Played At"
      n: "playedAt"
      r: true
      sh: "Timestamp when the song was played"
      t: "`$STRING`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "Title of the song"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "music"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /songs/recently-played"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 10
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/songs/recently-played"
          q: {
            exist: [
              "limit"
            ]
          }
          s: [
            {
              lit: "songs"
            }
            {
              lit: "recently-played"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.songs`"
          }
        }
      ]
    }
  }



}
